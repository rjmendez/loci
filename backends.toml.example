# Loci backend config — copy to ~/.loci/backends.toml (or point $LOCI_CONFIG at it) and edit.
# This file holds MACHINE-SPECIFIC endpoints/keys so they never live in the public repo.
# Resolution order per backend: env var > local probe (localhost) > this file > safe default.
# So on a laptop with its own Ollama you can leave everything blank (the probe finds it);
# on a headless box, point these at a GPU host reachable over your network (LAN, VPN/tailscale).
# The hosts below are PLACEHOLDERS — replace with your own.

[ollama]
# url = "http://gpu-host:11434"        # EMBEDDING endpoint (omit to use local :11434)
# gen_url = "http://gpu-host:11434"    # GENERATION endpoint — resolved SEPARATELY from `url`
                                        # (mcp/llm_local.py). These are often different hosts:
                                        # a shared/cluster Ollama may serve embeddings only, while
                                        # your own GPU box serves generation with a richer model
                                        # library. Omit gen_url to fall back to `url`.
# gen_model = "your-pulled-model:tag"  # must be a tag `ollama list` actually shows on gen_url —
                                        # an unpulled/misspelled tag fails EVERY generate() call
                                        # silently (fail-open -> degraded=True everywhere upstream:
                                        # compress_text, classify_text, query_expand, verify_finding)
# verify_model = "your-pulled-model:tag"   # optional: model for verify_finding's adversarial
                                            # reasoning specifically. If unset, falls back to
                                            # gen_model. Also the default for local_deep_think's
                                            # verify/synthesize/self-reflect and, unless the swarm
                                            # keys below are set, swarm_escalate's upper tiers.
# swarm_escalate_model = "your-pulled-model:tag"   # optional: swarm_escalate escalation tier
# swarm_synthesize_model = "your-pulled-model:tag" # optional: swarm_escalate synthesis tier
                                            # (env LOCI_SWARM_ESCALATE_MODEL / _SYNTHESIZE_MODEL
                                            # win; unset -> verify_model -> gen_model).
# classify_model = "your-pulled-model:tag" # optional: model for classify_text's short semantic
                                            # routing. Leave unset to use gen_model; set this when
                                            # you want tiny high-throughput classification isolated
                                            # from other generation tasks.
# compress_model = "your-pulled-model:tag" # optional: model for compress_text's summarization
                                            # specifically. If unset, falls back to gen_model.
                                            # Compress correctness varies far more across models
                                            # than classify does — worth tuning independently.
# guardian_model = "granite3-guardian:2b"  # optional: model for guardian.check_injection_risk's
                                            # jailbreak/prompt-injection classification. Does NOT
                                            # fall back to gen_model when unset (resolver now tries
                                            # installed guard/safety-friendly tags first, then
                                            # "granite3-guardian:2b") — Granite Guardian is
                                            # a purpose-built safety classifier tuned on a specific
                                            # risk-definition prompt shape, and routing this check
                                            # through an arbitrary chat model would produce
                                            # meaningless Yes/No output. Also consulted by
                                            # scripts/hooks/pre_tool_grounding.py (via
                                            # LOCI_OLLAMA_GUARDIAN_MODEL / OLLAMA_BASE_URL /
                                            # OLLAMA_GEN_URL env vars, since the hook is a
                                            # standalone stdlib script and doesn't import mcp/).
# redteam_model = "heretic-llama31-8b-instruct:latest"
                                            # optional: explicitly adversarial model for
                                            # scripts/local_deep_think.py's --red-team tier.
                                            # Resolver prefers this tag and, when it is absent,
                                            # auto-picks an installed heretic/abliterated tag.
#
# If gen_model is unset, resolver uses qwen2.5:3b when available, otherwise the first
# installed non-embedding local tag (to avoid broken defaults on sparse local installs).
# Explicit env/config still wins.
# Automatic picks (never an explicit env/config value) skip any installed model that
# `ollama list` reports above LOCI_OLLAMA_AUTO_MAX_GB (default 10): a model bigger than
# one GPU is split across cards by Ollama, and those loads can time out and stall its
# scheduler for every other model, embeddings included.
# For benchmark-driven assignment, generate this block from:
#   python3 scripts/assign_models_from_benchmark.py --benchmark-json <quality_run.json>
                                            # Aligned models often refuse or soften the
                                            # "attack this proposal as an adversary would"
                                            # framing used there.
#
# Gotcha on Windows+WSL2 (NAT networking, the default — no networkingMode=mirrored
# in .wslconfig): WSL cannot reach a Windows-bound Ollama via 127.0.0.1, the WSL
# default-route gateway IP, or any other Windows adapter IP, even with matching
# Windows Firewall allow rules already in place — NAT mode simply doesn't bridge
# WSL to arbitrary Windows-side ports that way. The one address that reliably
# works is the Windows host's OWN Tailscale (or other VPN mesh) IP, if it has one
# on the same tailnet as the WSL/Loci side. Confirm with a direct
# `curl http://<candidate-ip>:11434/api/tags` before trusting any IP guess.

[embed]
# model = "nomic-embed-text"

[vllm]
# url = "http://gpu-host:8000"         # batched OpenAI-compatible server (omit -> Ollama fallback)
# model = "Qwen/Qwen2.5-3B-Instruct"

[cloud]
# enabled = true                        # enable third-tier cloud fallback after local tiers fail
# supervisor_model = "your-pulled-model:tag"  # local supervisor that routes unspecified requests
                                       # by role (unset -> [ollama].verify_model -> gen_model)
# max_tokens_per_call = 512             # hard per-call cap for cloud fallback (0 disables)
# daily_call_budget = 200               # max cloud fallback calls/day UTC (0 disables)
# daily_token_budget = 50000            # max requested cloud tokens/day UTC (0 disables)
# deny_providers = ["abliteration"]     # optional deny-list: "openrouter", "abliteration"
# deny_roles = ["redteam"]              # optional deny-list: triage/coding/reasoning/synthesis/redteam
# allowed_roles = ["triage","coding"]   # optional allow-list; empty means all roles
# budget_state_path = "C:\\Users\\you\\.loci\\cloud_tier_budget.json"

[tmux_offload]
# enabled = false                       # safe default: feature off preserves existing routing
# role_sessions = {                     # role -> tmux session mapping (lane names are your choice)
#   triage = "loci-fast",
#   coding = "loci-code",
#   reasoning = "loci-reason",
#   synthesis = "loci-synth",
#   redteam = "loci-redteam"
# }
# expensive_roles = ["reasoning","synthesis","redteam"]  # roles to prioritize into "expensive" lanes
# require_mapped_session = false         # if true, fail closed when a mapped session is unavailable

[rerank]
# model = "BAAI/bge-reranker-v2-m3"    # default; or the lighter "cross-encoder/ms-marco-MiniLM-L-6-v2"

[qdrant]
# url = "http://qdrant-host:6333"
# api_key = "..."

[memory]
# dir = "/absolute/path/to/curated/MEMORY.md/dir"

[openrouter]
# url = "https://openrouter.ai/api/v1"
# key = "or-..."
# model = "qwen/qwen3.8-27b:free"      # shared cloud offload default when no role mapping is set
# [openrouter.triage]
# model = "qwen/qwen3.8-27b:free"
# [openrouter.coding]
# model = "prism-ml/ternary-bonsai-2-27b"
# [openrouter.reasoning]
# model = "z-ai/glm-5.3-flash"
# [openrouter.synthesis]
# model = "deepseek/deepseek-pro-latest"
# [openrouter.redteam]
# model = "qwen/qwen3.8-flash"

[abliteration]
# url = "https://api.abliteration.ai/v1"
# key = "..."
# model = "abliterated-model"          # heavy uncensored escalation default
# [abliteration.redteam]
# model = "abliterated-model-large-v2"
