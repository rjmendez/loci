{
  "artifact": "fbh_artifact_integrity_quarantine_policy",
  "date": "2026-09-22",
  "storage_root_env": "LOCI_FLYBRAIN_STORAGE_ROOT",
  "path_contract": {
    "staging_template": "$LOCI_FLYBRAIN_STORAGE_ROOT\\cache\\imports\\<dataset_symbol>\\<version_id>\\",
    "quarantine_template": "$LOCI_FLYBRAIN_STORAGE_ROOT\\cache\\quarantine\\<dataset_symbol>\\<version_id>\\<manifest_id>\\<event_ts>\\",
    "hardcoded_drive_paths_allowed": false
  },
  "manifest_alignment": {
    "schema_version": "fbh-manifest/v1",
    "required_integrity_fields": [
      "integrity.files[*].relative_path",
      "integrity.files[*].sha256"
    ],
    "size_requirement": "integrity.files[*].size_bytes is required when source metadata includes expected size",
    "verification_status_field": "integrity.verification.status",
    "verification_status_values": [
      "pending",
      "verified",
      "quarantined"
    ]
  },
  "verification_order": [
    "path_and_manifest_preflight",
    "file_presence_check",
    "expected_size_check",
    "partial_download_detection",
    "hash_verification",
    "aggregate_manifest_decision"
  ],
  "accepted_hash_algorithms": {
    "required": [
      "sha256"
    ],
    "optional_additive": [
      "sha512",
      "blake3"
    ],
    "not_accepted_as_sole_proof": [
      "md5",
      "sha1"
    ]
  },
  "partial_download_detection_signals": [
    "in_progress_file_extensions_detected(.partial,.tmp)",
    "observed_size_below_expected_size",
    "zero_byte_file_with_nonzero_expected_size",
    "content_length_mismatch_from_fetch_metadata",
    "container_parse_failure_for_expected_format"
  ],
  "mismatch_actions": [
    "block_sync_and_promotion",
    "move_failed_payload_to_quarantine_path",
    "emit_quarantine_event_json_with_expected_vs_observed_values",
    "set_integrity_verification_status_to_quarantined",
    "preserve_last_known_good_promoted_dataset"
  ],
  "quarantine_policy": {
    "report_file": "quarantine_event.json",
    "immutability": true,
    "minimum_retention_days": 30,
    "retain_until_incident_closed": true
  },
  "revalidation_policy": {
    "requires_fresh_refetch": true,
    "new_staging_path_required": true,
    "direct_restore_from_quarantine_allowed": false,
    "pass_criteria": [
      "size_match_when_expected_size_known",
      "required_sha256_match",
      "format_parse_smoke_pass",
      "manifest_status_verified"
    ]
  },
  "sync_pipeline_alignment": {
    "acquire_lane_output": "$LOCI_FLYBRAIN_STORAGE_ROOT\\cache\\imports\\...",
    "verify_lane_gate": "this_policy",
    "promote_lane_input": "verified_manifests_only",
    "runtime_lane_reads": "promoted_dataset_pointer_only"
  },
  "references": [
    "docs/FLYBRAIN_ARTIFACT_INTEGRITY_QUARANTINE_POLICY.md",
    "docs/FLYBRAIN_HARNESS_MANIFEST_PROVENANCE_SCHEMA.md",
    "docs/FLYBRAIN_NEO4J_NEUPRINT_LOCAL_STACK_PLAN.md",
    "docs/FLYBRAIN_WRITE_PATH_SAFETY_POLICY.md"
  ]
}
