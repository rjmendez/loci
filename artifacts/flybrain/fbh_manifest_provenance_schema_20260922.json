{
  "artifact": "fbh_manifest_provenance_schema",
  "date": "2026-09-22",
  "schema_version": "fbh-manifest/v1",
  "storage_root_env": "LOCI_FLYBRAIN_STORAGE_ROOT",
  "applies_to": [
    "dataset_snapshot",
    "metadata_snapshot"
  ],
  "required_fields": {
    "top_level": [
      "schema_version",
      "manifest_id",
      "generated_at",
      "storage_root_env",
      "artifact",
      "dataset",
      "scope",
      "integrity",
      "refresh",
      "lineage"
    ],
    "dataset": [
      "symbol",
      "version_id",
      "source.system",
      "source.access_method",
      "source.retrieved_at",
      "source.license.spdx_id"
    ],
    "scope": [
      "sex",
      "stage",
      "anatomy",
      "evidence_family",
      "claim_tier"
    ],
    "integrity": [
      "files[*].relative_path",
      "files[*].sha256"
    ],
    "refresh": [
      "decision",
      "checked_at"
    ]
  },
  "path_contract": {
    "path_template_prefix": "$LOCI_FLYBRAIN_STORAGE_ROOT\\",
    "absolute_paths_allowed": false,
    "file_paths_must_be_relative": true
  },
  "enum_constraints": {
    "refresh_decision": [
      "no_change",
      "patch_refresh",
      "major_bump",
      "rollback"
    ],
    "claim_tier": [
      "T0_dataset_run_specific",
      "T1_dataset_version_specific",
      "T2_cross_dataset_matched_scope",
      "T3_broad_generalization"
    ]
  },
  "checksum_contract": {
    "algorithm": "sha256",
    "optional_algorithms": [
      "sha512",
      "blake3"
    ],
    "format": "lowercase_hex_64",
    "manifest_hash_field": "integrity.manifest_sha256",
    "file_hash_field": "integrity.files[*].sha256"
  },
  "size_and_quarantine_contract": {
    "size_field": "integrity.files[*].size_bytes",
    "size_rule": "required_when_source_metadata_provides_expected_size",
    "mismatch_action": "quarantine_and_block_promotion",
    "policy_doc": "docs/FLYBRAIN_ARTIFACT_INTEGRITY_QUARANTINE_POLICY.md"
  },
  "reproducibility_key": [
    "dataset.symbol",
    "dataset.version_id",
    "dataset.source.access_method"
  ],
  "refresh_tracking": {
    "cadence_required": true,
    "supersede_link_field": "refresh.supersedes_manifest_id",
    "stale_rule": "reader_flags_stale_if_next_check_due_is_past"
  },
  "lineage_contract": {
    "derived_from_required": true,
    "pipeline_fields": [
      "lineage.pipeline.job_name",
      "lineage.pipeline.job_version",
      "lineage.pipeline.run_id"
    ]
  },
  "examples": {
    "hb_graph": {
      "path_template": "$LOCI_FLYBRAIN_STORAGE_ROOT\\datasets\\hb\\neuprint_JRC_Hemibrain_1point2point1\\graph\\",
      "dataset_symbol": "hb",
      "version_id": "neuprint_JRC_Hemibrain_1point2point1",
      "claim_scope": {
        "sex": "female",
        "stage": "adult",
        "anatomy": "hemibrain_region"
      }
    },
    "fw_metadata": {
      "path_template": "$LOCI_FLYBRAIN_STORAGE_ROOT\\datasets\\fw\\flywire783\\metadata\\",
      "dataset_symbol": "fw",
      "version_id": "flywire783",
      "claim_scope": {
        "sex": "female",
        "stage": "adult",
        "anatomy": "whole_brain_fafb_aligned"
      }
    }
  },
  "references": [
    "docs/FLYBRAIN_HARNESS_MANIFEST_PROVENANCE_SCHEMA.md",
    "docs/FLYBRAIN_ARTIFACT_INTEGRITY_QUARANTINE_POLICY.md",
    "docs/FLYBRAIN_DATA_PROVENANCE_GUIDANCE.md",
    "docs/FLYBRAIN_HARNESS_STORAGE_LAYOUT.md",
    "docs/FLYBRAIN_WRITE_PATH_SAFETY_POLICY.md",
    "docs/FLYBRAIN_DATASET_PROVENANCE_MATRIX.md"
  ]
}
