{
  "artifact": "fbh_rollout_milestones",
  "date": "2026-09-22",
  "storage_root_env": "LOCI_FLYBRAIN_STORAGE_ROOT",
  "milestones": [
    {
      "id": "M0",
      "name": "dry_run_inventory_gate",
      "run_mode": "dry-run",
      "writes_allowed": [
        "logs\\pipelines\\<run_id>\\preflight.json",
        "logs\\pipelines\\<run_id>\\inventory.json"
      ],
      "exit_criteria": [
        "path_guard_pass",
        "phase1_scope_pin_pass",
        "budget_status_recorded_without_hard_stop"
      ]
    },
    {
      "id": "M1",
      "name": "plan_freeze_gate",
      "run_mode": "plan",
      "writes_allowed": [
        "logs\\pipelines\\<run_id>\\plan.json",
        "logs\\pipelines\\<run_id>\\stage_state\\*.json"
      ],
      "exit_criteria": [
        "deterministic_stage_graph_complete",
        "stage_idempotency_keys_persisted",
        "predicted_writes_within_allowlisted_subtrees"
      ]
    },
    {
      "id": "M2",
      "name": "execute_snapshot_manifest_gate",
      "run_mode": "execute",
      "writes_allowed": [
        "cache\\downloads\\<dataset>\\<version>\\*",
        "snapshots\\<dataset>\\<version>\\source\\*",
        "snapshots\\<dataset>\\<version>\\manifest\\manifest.json",
        "snapshots\\<dataset>\\<version>\\manifest\\manifest.sha256"
      ],
      "exit_criteria": [
        "required_file_integrity_pass",
        "resume_state_persisted",
        "manifest_schema_and_path_safety_pass"
      ]
    },
    {
      "id": "M3",
      "name": "first_reproducible_local_query_harness_gate",
      "run_mode": "execute",
      "writes_allowed": [
        "graph\\hb\\<version_id>\\neo4j-store\\candidate-<build_id>\\*",
        "graph\\hb\\<version_id>\\promotion\\*",
        "logs\\harness\\<harness_run_id>\\query_pack.json",
        "logs\\harness\\<harness_run_id>\\results.json"
      ],
      "exit_criteria": [
        "candidate_graph_smoke_queries_pass",
        "atomic_promotion_pointer_update_pass",
        "query_pack_with_config_fingerprint_persisted",
        "replay_hash_consistency_pass_or_documented_variance"
      ]
    }
  ],
  "required_variables": [
    "LOCI_FLYBRAIN_STORAGE_ROOT",
    "LOCI_FLYBRAIN_RUN_MODE",
    "LOCI_FLYBRAIN_DATASET_SCOPE",
    "LOCI_FLYBRAIN_DATASET_VERSION_PINS",
    "LOCI_FLYBRAIN_MAX_RETRIES",
    "LOCI_FLYBRAIN_RETRY_BACKOFF_SECONDS",
    "LOCI_FLYBRAIN_CONTINUE_ON_DATASET_FAILURE"
  ],
  "phase1_scope": {
    "datasets": [
      {
        "symbol": "hb",
        "version_id": "neuprint_JRC_Hemibrain_1point2point1"
      },
      {
        "symbol": "fw",
        "version_id": "flywire783"
      }
    ]
  },
  "always_stop_conditions": [
    "path_policy_violation",
    "required_checksum_mismatch",
    "manifest_schema_violation",
    "unapproved_scope_pin",
    "promotion_pointer_integrity_risk"
  ],
  "references": [
    "docs/FLYBRAIN_HARNESS_ROLLOUT_MILESTONES.md",
    "docs/FLYBRAIN_FETCH_SYNC_PIPELINES_PLAN.md",
    "docs/FLYBRAIN_NEO4J_NEUPRINT_LOCAL_STACK_PLAN.md",
    "docs/FLYBRAIN_HARNESS_STORAGE_LAYOUT.md",
    "docs/FLYBRAIN_WRITE_PATH_SAFETY_POLICY.md"
  ]
}
