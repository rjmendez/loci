#!/usr/bin/env bash
# flybrain-slot <cmd...> — run a heavy FlyBrain job in one of N concurrent slots.
#
# Replaces the single global /tmp/flybrain-heavy.lock (one heavy job at a time),
# which left jobs waiting hours on a 28-core / 62 GB machine where each heavy job
# uses 2-4 GB. Takes the first free slot of FLYBRAIN_SLOTS (default 3); if none is
# free, waits and retries. The slot is held (flock) for the life of the command.
set -euo pipefail
[ $# -ge 1 ] || { echo "usage: flybrain-slot <command...>" >&2; exit 2; }
slots="${FLYBRAIN_SLOTS:-3}"
waited=0
while :; do
  for i in $(seq 1 "$slots"); do
    lock="/tmp/flybrain-slot-$i.lock"
    exec {fd}>"$lock"
    if flock -n "$fd"; then
      echo "[flybrain-slot] slot $i/$slots acquired after ${waited}s: $*" >&2
      "$@"
      rc=$?
      exit "$rc"
    fi
    exec {fd}>&-
  done
  sleep 10
  waited=$((waited + 10))
done
