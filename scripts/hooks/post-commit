#!/usr/bin/env bash
# post-commit: re-ingest loci-codebase when Python files change and refresh
# contract extraction for changed source files.
#
# Hook failures must never block commits. Keep this script fail-open: wrap work
# in main, ignore main's status at the end, and use background jobs for Claude.

set -uo pipefail

main() {
  local repo_root changed log_dir
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  changed="$(git diff-tree --root --no-commit-id -r --name-only HEAD 2>/dev/null || true)"

  if [[ -z "$changed" ]]; then
    return 0
  fi

  log_dir="$repo_root/.git/loci-hook-logs"
  mkdir -p "$log_dir" 2>/dev/null || log_dir="$repo_root/.git"

  if grep -qE '\.py$' <<<"$changed"; then
    echo "[post-commit] Python files changed — triggering loci-codebase re-ingest..."
    if command -v claude >/dev/null 2>&1; then
      (
        cd "$repo_root" || exit 0
        env -u ANTHROPIC_API_KEY \
          claude -p --dangerously-skip-permissions "/loci-codebase-ingest"
      ) >> "$log_dir/loci-post-commit-ingest.log" 2>&1 &
    else
      echo "[post-commit] Warning: 'claude' CLI not found; skipping ingest." >&2
    fi
  fi

  if grep -qE '\.(py|ts|go|rs|java)$' <<<"$changed"; then
    "$repo_root/scripts/hooks/post-commit-contract-extract.sh" || true
  fi
}

main "$@" || true
exit 0
